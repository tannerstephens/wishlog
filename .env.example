# Copy to .env and adjust. Everything here is optional; the defaults work.
#
# Leave a setting commented out rather than setting it to an empty value:
# an empty value overrides the container's default.

# Host port the app is published on (used by docker-compose.yml only)
WISHLOG_PORT=8080

# Secret used to sign login sessions. If unset, a random key is generated on
# first start and kept in the database volume, so logins survive restarts.
# Set it explicitly to manage the key yourself. Generate one with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
# SECRET_KEY=

# Where the generated secret key is stored when SECRET_KEY is unset
# SECRET_KEY_FILE=/var/database/.secret_key

# Database connection. Only SQLite is supported out of the box.
# Note the four slashes for an absolute path.
# DATABASE_URI=sqlite:////var/database/wishlog.db

# Directory uploaded images are stored in
# IMAGE_STORAGE_DIRECTORY=/var/images
